@@ -2269,3 +2274,69 @@ body.balance-hidden #bill-detail-summary .v {
   user-select: none;
   transition: filter .15s ease;
 }
+
+/* ══════════════════════════════════════════════════════════════════════
+   Acessibilidade — base do arquivo inteiro. Fica no fim de propósito:
+   sem !important, ganha por ordem de cascata de qualquer regra acima.
+   ══════════════════════════════════════════════════════════════════════ */
+
+/* Foco visível padrão. Havia 21 regras de :focus-visible espalhadas, uma por
+   componente — quem não estava na lista ficava sem indicador nenhum. Isto é o
+   piso; as regras específicas continuam ganhando por especificidade. */
+:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
+  outline: 2px solid var(--purple);
+  outline-offset: 2px;
+  border-radius: 4px;
+}
+
+/* prefers-reduced-motion. Antes deste bloco o arquivo tinha UMA regra
+   (.loading-sticker) para 21 `animation:` e 75 `transition:` declarados. */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: .01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .01ms !important;
+    scroll-behavior: auto !important;
+  }
+  html { scroll-behavior: auto; }
+  .orb, .loading-sticker { animation: none !important; }
+}
+
+/* ══════════════════════════════════════════════════════════════════════
+   Header no mobile — medido em 375×812: as três linhas do topo somavam
+   ~320px, 39% da tela, antes de um único número aparecer. Importar OFX e
+   Exportar são tarefas de desktop ocupando o espaço mais caro do celular:
+   viram ícone (o aria-label/title carrega o nome), e o status vira só o
+   ponto. A ação primária "+ Lançar" continua sendo a única em rosa.
+   ══════════════════════════════════════════════════════════════════════ */
+@media (max-width: 720px) {
+  .header-right .hbtn-label { display: none; }
+  .header-right #status span { display: none; }
+  .header-right #status { padding: 0; }
+  /* alvo de toque 44×44 mesmo sem rótulo */
+  .header-right .hbtn:not(.user-menu-btn) {
+    min-width: 44px; min-height: 44px;
+    justify-content: center; padding: 0 10px;
+  }
+}
+
+/* Superfície de dado é opaca. Os cards de KPI usavam --glass-bg (branco a 7%),
+   então os orbs magenta do fundo atravessavam e tingiam o número — no mobile a
+   coluna inteira lia rosa. Rosa é ação e marca, não superfície de leitura. */
+.ov-stat { background: #17171b; }
+body.light .ov-stat { background: #fff; }
+
+/* O FAB é fixo e não reservava espaço abaixo de si: cobria conteúdo em três
+   telas (toast do dashboard vazio, última linha de "Top estabelecimentos",
+   canto do card de Receitas no mobile). O padding devolve a faixa. */
+body.has-sidenav .dash-main,
+#dashboard-content { padding-bottom: 96px; }
+
+/* Estado vazio dentro do quadro de um gráfico — mesmo par (sticker + frase) dos
+   vazios de Orçamentos/Cartões, só que ocupando a altura que o canvas ocuparia. */
+.chart-empty {
+  display: flex; flex-direction: column; align-items: center; justify-content: center;
+  gap: 10px; min-height: 180px; text-align: center; padding: 20px;
+}
+.chart-empty .empty-sticker { width: 84px; height: auto; opacity: .9; }
+.chart-empty-txt { color: var(--text-2); font-size: .88rem; max-width: 34ch; line-height: 1.5; }
