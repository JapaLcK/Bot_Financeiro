+      '<div class="chart-empty-txt"></div>';
+    box.appendChild(d);
+    d.querySelector(".chart-empty-txt").textContent = msg;
+  } else {
+    prev.querySelector(".chart-empty-txt").textContent = msg;
+  }
+  return true;
+}
