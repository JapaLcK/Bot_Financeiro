# ─────────────────────────────────────────────────────────────────────────────
# FinBot — Variáveis de Ambiente
# Copie este arquivo para `.env` ou `.env.staging` e preencha os valores.
# No Railway: adicione cada variável em Settings → Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Ambiente lógico opcional. Ex.:
# APP_ENV=prod     -> carrega `.env`
# APP_ENV=staging  -> carrega `.env` + `.env.staging`
APP_ENV=dev

# ── Banco de Dados ────────────────────────────────────────────────────────────
# URL de conexão PostgreSQL (Railway preenche automaticamente se você
# adicionar um serviço PostgreSQL ao projeto).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Dashboard ─────────────────────────────────────────────────────────────────
# URL pública do serviço (Railway preenche após o primeiro deploy).
# Ex: https://dashboard-production-020d.up.railway.app
DASHBOARD_URL=https://seu-projeto.up.railway.app

# Fuso do app. Um valor só governa TRÊS relógios que precisam concordar: o
# PROCESSO (`date.today()`, `datetime.now()` naive), o APP (`utils_date._tz()`)
# e a SESSÃO do Postgres (`::date`, `date_trunc`, e a promoção de `timestamp`
# naive a `timestamptz` — é por ela que a fronteira do dia é resolvida).
# Precedência: REPORT_TIMEZONE ganha de TZ SEMPRE, venha de onde vier — arquivo
# inclusive. Só entre um TZ e outro TZ é que o do ambiente real ganha do daqui.
# Logo: com as duas linhas abaixo preenchidas, editar só o TZ é no-op silencioso
# — mude REPORT_TIMEZONE (ou apague-o) para trocar o fuso.
# Nome IANA; inválido recusa o boot.
REPORT_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# Intervalo (segundos) de atualização automática via WebSocket.
POLL_INTERVAL=30

# ── Meta (Facebook) Pixel + Conversions API ─────────────────────────────────────
# ID do Pixel do Meta Ads. Quando preenchido, o pixel é injetado no <head> das
# páginas públicas (landing, /precos, /cadastro, /login, etc.) e dispara:
#   • PageView          — em toda página pública
#   • ViewContent       — ao abrir a página de planos (/precos)
#   • CompleteRegistration — quando a conta é criada (/cadastro)
#   • InitiateCheckout  — ao clicar em "Assinar" em /precos
#   • StartTrial        — no início do trial (retorno do checkout)
#   • Purchase          — na compra imediata (checkout sem trial)
# Deixe vazio em dev/staging para não carregar nenhum rastreio.
META_PIXEL_ID=
#
# Token da Conversions API (server-side). Opcional, mas recomendado: o backend
# dispara os eventos server-a-servidor com o mesmo event_id do pixel (o Meta
# deduplica → conta a conversão uma vez só). Cobre CompleteRegistration,
# StartTrial e o Purchase da cobrança REAL (fim do trial + renovações, via
# invoice.paid da Stripe, com o valor efetivamente pago).
# Mais preciso e imune a adblock/iOS. Gere em: Events Manager → seu Pixel →
# Configurações → Conversions API → "Gerar token de acesso".
# Requer META_PIXEL_ID setado. Vazio → só o rastreio client-side roda.
META_PIXEL_ACCESS_TOKEN=

# ── Google Analytics 4 ──────────────────────────────────────────────────────
# Measurement ID da propriedade. Já vem chumbado no código (é público: sai no
# fonte de toda página), então esta variável serve para DESLIGAR ou apontar para
# outra propriedade. Injetado nas MESMAS páginas do Meta Pixel e dispara:
#   • page_view          — automático, em toda página pública
#   • view_item_list     — ao abrir a página de planos (/precos)
#   • begin_checkout     — ao clicar em "Assinar" em /precos
#   • sign_up            — conta criada (method: email | google)
#   • onboarding_complete — fim do wizard de primeira configuração
#   • start_trial        — início do trial (retorno do checkout)
#   • purchase           — compra imediata (checkout sem trial)
# `GA4_MEASUREMENT_ID=` vazio em dev/staging → nenhum rastreio do Google.
GA4_MEASUREMENT_ID=G-0H8FHNQ3C4

# ── Privacidade / exclusão de conta ──────────────────────────────────────────
# Limite de contas removidas por execução do job dedicado no Railway.
ACCOUNT_DELETION_JOB_LIMIT=50

# E-mail público exibido nos avisos de suporte.
SUPPORT_EMAIL=contato@pigbankai.com

# ── Autenticação (JWT) ────────────────────────────────────────────────────────
# Segredo para assinar tokens JWT. Use uma string longa e aleatória.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# ── MFA (TOTP cifrado em repouso) ────────────────────────────────────────────
# Chave Fernet usada para cifrar o segredo TOTP em user_mfa.secret_encrypted.
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=troque-por-uma-chave-fernet

# ── Cifragem column-level de PII (email, phone, nome, IDs externos) ──────────
# Ver core/crypto.py. Gere AMBAS as chaves com:
#   python -m scripts.generate_pii_keys
#
# PII_ENCRYPTION_KEY: chave Fernet (rotacionável — manter v1 em paralelo
#   durante rotação, definindo PII_ENCRYPTION_KEY_V1 com a chave antiga).
# PII_HASH_PEPPER:    pepper HMAC-SHA256 do hash determinístico. NUNCA rotacionar
#   em produção — todos os hashes existentes deixam de bater.
#
# ⚠️ Guarde backup das 2 chaves num cofre fora do Railway. Sem elas,
#    os PII cifrados ficam ilegíveis e nenhum usuário consegue logar.
PII_ENCRYPTION_KEY=troque-por-uma-chave-fernet
PII_HASH_PEPPER=troque-por-um-segredo-de-no-minimo-32-caracteres

# Desabilita o registro em pii_access_log (use só em scripts de migration
# que cifram em batch e não devem inflar o audit). Default: vazio (audit ligado).
# PII_AUDIT_DISABLED=1

# ── Painel Admin Privado ─────────────────────────────────────────────────────
# Credenciais exclusivas do painel administrativo interno.
# Configure SOMENTE no ambiente do deploy ou no seu .env local, nunca no repositório.
ADMIN_DASHBOARD_USERNAME=admin
# Senha SEMPRE como hash bcrypt — plaintext (ADMIN_DASHBOARD_PASSWORD) é
# tolerada só em dev local e BLOQUEIA O BOOT com APP_ENV=prod. Gere o hash:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt()).decode())"
ADMIN_DASHBOARD_PASSWORD_HASH=$2b$12$troque-pelo-hash-gerado
# ADMIN_DASHBOARD_PASSWORD=so-para-dev-local
ADMIN_DASHBOARD_SESSION_HOURS=12

# ── Bot Discord ───────────────────────────────────────────────────────────────
# Para staging, crie um segundo bot/aplicação no Discord Developer Portal
# e use outro token para não responder no servidor de produção.
DISCORD_BOT_TOKEN=seu-token-do-discord-aqui

# ── Bot WhatsApp (Meta Cloud API) ─────────────────────────────────────────────
# Número público do bot no formato internacional, sem + e sem espaços.
# Usado para montar links wa.me após o cadastro.
WHATSAPP_NUMBER=5511999999999

# Token de acesso da Meta com permissões de WhatsApp Business.
WA_TOKEN=EAAB...

# ID técnico do número no WhatsApp Cloud API (phone_number_id).
WA_PHONE_NUMBER_ID=123456789012345

# Token de verificação usado pela Meta no GET do webhook.
WA_VERIFY_TOKEN=seu_verify_token_aqui

# App Secret da Meta para validar assinatura do webhook recebido.
WA_APP_SECRET=seu_app_secret_aqui

# Versão da Graph API da Meta.
WA_GRAPH_VERSION=v25.0

# Template aprovado na Meta para mensagem proativa no WhatsApp.
# Fora da janela de 24h, o WhatsApp aceita apenas templates aprovados; mensagens
# comuns enviadas logo depois do template ainda falham com erro 131047.
# Exemplo de texto do template aprovado:
# "Olá! Tenho uma atualização financeira do PigBank AI para você."
WA_PROACTIVE_TEMPLATE_NAME=
WA_PROACTIVE_TEMPLATE_LANGUAGE=pt_BR

# Se o template aprovado tiver placeholders nomeados no corpo, por exemplo:
# {{saldo}}, {{gastos}}, {{receita}} e {{lancamentos}},
# habilite esta opção para enviar os valores dentro do próprio template.
WA_PROACTIVE_TEMPLATE_INCLUDE_REPORT=0

# Se o template aprovado tiver um botão de resposta rápida "Parar resumo",
# habilite esta opção para enviar o payload que o bot usa para cancelar.
WA_PROACTIVE_TEMPLATE_STOP_BUTTON=0

# Template aprovado na Meta para campanhas curtas de atualizações do Piggy.
# Usado por scripts/send_update_whatsapp.py.
WA_UPDATE_TEMPLATE_NAME=atualizacao_pigbank
WA_UPDATE_TEMPLATE_LANGUAGE=pt_BR

# Se o template de atualização tiver um botão de resposta rápida para parar
# atualizações, habilite para enviar o payload tratado pelo webhook.
WA_UPDATE_TEMPLATE_STOP_BUTTON=0

# ── Resumos periódicos no WhatsApp (semanal / mensal) ─────────────────────────
# Templates aprovados na Meta para os resumos automáticos (semanal toda segunda,
# mensal todo dia 1º). Enquanto vazios, o bot simplesmente não envia esses
# resumos pelo WhatsApp (não dá erro). Crie/registre os templates com:
#   python scripts/create_whatsapp_report_templates.py --dry-run   # confere o payload
#   python scripts/create_whatsapp_report_templates.py             # cria na Meta
# Depois de APROVADOS, preencha os nomes abaixo (iguais aos nomes na Meta).
# Corpo esperado (parâmetros nomeados): {{periodo}} {{saldo}} {{gastos}} {{receita}} {{lancamentos}}
WA_WEEKLY_TEMPLATE_NAME=
WA_MONTHLY_TEMPLATE_NAME=

# Se os templates de resumo tiverem o botão de resposta rápida "Desligar resumo",
# habilite para o bot enviar o payload que desliga o resumo (semanal/mensal).
WA_PERIODIC_TEMPLATE_STOP_BUTTON=0

# ID da conta WhatsApp Business (WABA) — NÃO é o phone_number_id.
# Necessário só para criar templates via scripts/create_whatsapp_report_templates.py.
WA_BUSINESS_ACCOUNT_ID=

# Endpoints e simulacao local do WhatsApp.
# ENABLE_DEV_ENDPOINTS registra /wa/dev/simulate apenas em dev/staging.
# WA_SIMULATION_ONLY faz /wa/dev/simulate apenas extrair/retornar mensagens,
# sem processar comandos, gravar no banco ou enviar resposta pelo WhatsApp.
ENABLE_DEV_ENDPOINTS=0
WA_SIMULATION_ONLY=0

# ── Investimentos ────────────────────────────────────────────────────────────
# Atualiza automaticamente os saldos de investimentos em background.
# O cálculo só avança quando há taxa oficial nova disponível (CDI/Selic/IPCA).
INVESTMENT_ACCRUAL_INTERVAL_HOURS=6
INVESTMENT_ACCRUAL_STARTUP_DELAY_SECONDS=90

# ── IA (OpenAI) ───────────────────────────────────────────────────────────────
# Necessário para categorização por IA (fallback automático).
# Deixe em branco para usar apenas as regras locais.
OPENAI_API_KEY=sk-...

# ── Stripe (Pagamentos) ───────────────────────────────────────────────────────
# 1. Crie uma conta em https://stripe.com
# 2. Vá em Developers → API Keys para obter a Secret Key
# 3. Crie um produto + preço recorrente (mensal) e copie o Price ID
# 4. Configure um webhook em Developers → Webhooks apontando para:
#    https://seu-projeto.up.railway.app/billing/webhook
#    Eventos necessários: checkout.session.completed, invoice.paid,
#    invoice.payment_failed, customer.subscription.deleted
# 5. Copie o Signing Secret do webhook

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

# ── Pluggy / Open Finance ───────────────────────────────────────────────────
# Use client id/secret somente no backend. Nunca coloque estas chaves no HTML.
PLUGGY_CLIENT_ID=seu_client_id
PLUGGY_CLIENT_SECRET=seu_client_secret
PLUGGY_BASE_URL=https://api.pluggy.ai
# Opcional: se preenchida, reutiliza uma API Key Pluggy existente.
# Se ficar vazia, o backend gera uma API Key temporária via client id/secret.
PLUGGY_API_KEY=
PLUGGY_PRODUCTS=ACCOUNTS,TRANSACTIONS,CREDIT_CARDS,INVESTMENTS
PLUGGY_INCLUDE_SANDBOX=0
# Opcional em produção. Se vazio e DASHBOARD_URL for https, usa:
# {DASHBOARD_URL}/open-finance/pluggy/webhook
PLUGGY_WEBHOOK_URL=
PLUGGY_WEBHOOK_SECRET=

# Ajuste fino do Open Finance. Todas têm default no código — as linhas abaixo
# mostram o valor em vigor; descomente só para mudar.
#
# KILL SWITCH do job de saúde. Ele VEM LIGADO (é a única coisa do Open Finance
# que roda mesmo com OF_REFRESH_ENABLED desligado, o default de produção): só faz
# GET /items (não consome cota de coleta) e é o que tira do "Atualizado" a
# conexão cujo item sumiu da Pluggy. Para desligar: 0/false/no/off.
# OF_HEALTH_CHECK_ENABLED=1
# Só remede conexão com saúde mais velha que isto (12h).
# OF_HEALTH_MAX_AGE_SEC=43200
# Disjuntor do job de saúde: se NINGUÉM respondeu e mais que esta % da amostra
# deu 404, a passada aborta sem gravar (credencial errada marcaria a base toda
# como "conexão perdida"). 100 desliga o disjuntor.
# OF_HEALTH_MISSING_ABORT_PCT=50
# Amostra mínima para o disjuntor acima valer.
# OF_HEALTH_MIN_SAMPLE=5
# Refresh proativo (só com OF_REFRESH_ENABLED=1): intervalo mínimo por item, 6h,
# persistido em next_refresh_at — reiniciar o processo não o encurta.
# OF_REFRESH_MIN_INTERVAL_SEC=21600
# Jitter (%) aplicado ao intervalo acima, pra os items não baterem na Pluggy no
# mesmo segundo.
# OF_REFRESH_JITTER_PCT=10
# Botão "Atualizar" / pull-to-refresh: janela em que um item não leva PATCH novo
# (protege a cota de COLETA; ler o que a Pluggy já tem continua acontecendo).
# OF_MANUAL_REFRESH_COOLDOWN_SEC=120
# Lock por item do sync: quanto esperar pelo lock antes de desistir (15s).
# OF_SYNC_LOCK_WAIT_MS=15000
# Teto de conexões simultâneas segurando lock de sync.
# OF_SYNC_LOCK_MAX_CONN=8

# ── Google OAuth (Login com Google) ──────────────────────────────────────────
# Como obter:
# 1. Acesse https://console.cloud.google.com/apis/credentials
# 2. Crie uma credencial "OAuth client ID" do tipo "Web application"
# 3. Em "Authorized redirect URIs", adicione:
#      https://seu-dominio/auth/google/callback
#      http://localhost:8000/auth/google/callback   (para dev)
# 4. Copie o Client ID e Client Secret abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio/auth/google/callback

# ── Notificações administrativas (Slack/Discord webhook) ────────────────────
# URL de webhook pra alertar o operador sobre eventos críticos: novos Pros,
# falhas de pagamento, cancelamentos. Auto-detecta provider pelo URL.
# Deixe vazio pra desabilitar (silencioso).
#
# Slack:   https://hooks.slack.com/services/T.../B.../...
# Discord: https://discord.com/api/webhooks/{id}/{token}
ADMIN_NOTIFY_WEBHOOK_URL=

# ── Opcional ──────────────────────────────────────────────────────────────────
# ID do usuário padrão do dashboard (auto-detectado se omitido).
# DASHBOARD_USER_ID=1
