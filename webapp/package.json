{
  "name": "pigbank-webapp",
  "private": true,
  "type": "module",
  "description": "Ilhas React de preços e chats. Build separado da raiz, artefatos IIFE de nome fixo servidos pelo backend.",
  "scripts": {
    "build": "vite build && vite build --config vite.chat.config.ts && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build:dashboard": "vite build --config vite.dashboard.config.ts",
    "watch:dashboard": "vite build --watch --config vite.dashboard.config.ts"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "motion": "13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4",
    "typescript": "^7.0.2",
    "vite": "8.3.0"
  }
}
