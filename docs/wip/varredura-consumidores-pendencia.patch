+def consume_pending_action(user_id: int, pending: dict | None) -> bool:
+    """Apaga a pendência que foi LIDA — e só ela. True se apagou.
+
+    `clear_pending_action` apaga o que estiver na linha, não o que quem chamou
+    leu. Enquanto uma pergunta não podia substituir outra isso era inofensivo;
+    com `claim_pending_action` deixando a mesma pergunta chegar por outra porta
+    (`_PERGUNTA_DE_VALOR_DE_CONTA`), o Discord pode gravar uma pergunta NOVA
+    entre a leitura e o clear — e o clear apagava a pergunta nova, deixando o
+    usuário com uma pergunta na tela cuja resposta não resolve mais nada.
+
+    Quem perde o CAS não é mais o dono daquela pendência: em geral não deve
+    seguir com o trabalho (ver os `if not consume_pending_action(...)` nos
+    caminhos que registram dinheiro).
+    """
+    if not pending:
+        return False
+    return advance_pending_action(
+        user_id,
+        pending.get("action_type") or "",
+        pending.get("payload") or {},
+        None,
+    )
+
