+    tem_gasto = bool(_PEDE_GASTO_RE.search(fora_da_categoria))
+    tem_receita = bool(_PEDE_RECEITA_RE.search(fora_da_categoria))
+    if tem_gasto and tem_receita:
+        return None
+    if tem_gasto:
+        return "despesa"
+    if tem_receita:
+        return "receita"
+    return None
