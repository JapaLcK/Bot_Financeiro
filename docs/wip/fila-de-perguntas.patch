+
+def test_um_valor_dois_destinos_pergunta_os_dois():
+    # decisão do dono: um valor para dois destinos é ambíguo — o R$30 pode ser
+    # o total ou o de cada um. Sai em dois pedaços SEM valor, e o bot pergunta
+    # os dois. Áudio e texto usam o MESMO separador, então a regra é uma só.
+    assert split("gastei 30 no uber e no ifood") == ["gastei uber", "gastei no ifood"]
+
+
+# ── rede de proteção: repetir/dividir aqui INVENTA gasto ─────────────────────
+# Cada um destes tem um " e " ou um segundo número que NÃO é um segundo
+# lançamento: metade do mesmo serviço, item de lista, unidade, quantidade,
+# data, hora, parcela, identificador de cartão, ou o "e" de dentro do número.
+
+@pytest.mark.parametrize("txt", [
+    "gastei cento e vinte no mercado",
+    "gastei 80 no banho e tosa",
+    "paguei 50 de agua e luz",
+    "comprei 100 de arroz e feijão",
+    "paguei 100 de uber e gasolina",   # mesma categoria nos dois → não divide
+    "gastei 50 no posto 20 litros",
+    "comprei 3 cervejas 15 reais",
+    "paguei 100 do cartão 1234",
+    "gastei 30 no uber dia 15",
+    "gastei 30 no uber 15 de janeiro",
+    "gastei 100 no mercado às 15h",
+    "gastei 100 no cartão em 3x",
+    "parcelei 300 em 6 vezes",
+])
+def test_rede_de_protecao_nao_divide(txt):
+    assert split(txt) == [txt]
+
+
+def test_item_final_sem_valor_continua_perguntando_nao_repetindo():
+    # "e o aluguel" NÃO herda os R$30 do café — vira um pedaço sem valor, que
+    # o launches.add enfileira pra perguntar "quanto foi?".
+    assert split("gastei 500 no ifood, 30 café e o aluguel") == [
+        "gastei 500 no ifood",
+        "gastei 30 café",
+        "gastei o aluguel",
+    ]
