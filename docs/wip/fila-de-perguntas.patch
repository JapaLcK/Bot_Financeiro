+def test_pool_aguenta_um_usuario_por_conexao_disponivel():
+    """Uma resposta por usuário, todas ao mesmo tempo, tantas quantas o pool
+    comporta. Com o lock antigo: ok=0, erros=8."""
+    from db.connection import _get_pool
+    n = _get_pool().max_size
+    uids = []
+    for _ in range(n):
+        u = int(uuid.uuid4().int % 10_000_000_000)
+        db.ensure_user(u)
+        launches.add(u, "gastei 30 e 45", {})
+        uids.append(u)
+    largada = threading.Barrier(n, timeout=15)
+    ok: list[float] = []
+    erros: list[str] = []
+
+    def responder(u):
+        try:
+            largada.wait()
+            launches.resolve_multi_launch_value(u, "uber")
+            ok.append(1.0)
+        except BaseException as e:          # noqa: BLE001 - o teste quer ver
+            erros.append(f"{type(e).__name__}: {e}")
+
+    ts = [threading.Thread(target=responder, args=(u,)) for u in uids]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join(timeout=45)
+    try:
+        assert not erros, erros
+        assert len(ok) == n, f"{len(ok)} de {n}"
+        assert not [t for t in ts if t.is_alive()], "thread presa"
+    finally:
+        for u in uids:
+            db.clear_pending_action(u)
+
