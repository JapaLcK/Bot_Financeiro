+
+# ── 14. fila nova não engole a antiga em silêncio ───────────────────────────
+
+def test_fila_nova_avisa_o_que_a_antiga_levou(user_id):
+    """`pending_actions` tem UMA linha por usuário: gravar a fila nova apaga a
+    antiga. Medido antes: "gastei 30 e 45" e logo "gastei 60 e 70" deixava a
+    fila [60, 70] e os R$ 30,00 e R$ 45,00 sumiam sem uma palavra."""
+    launches.add(user_id, "gastei 30 e 45", {})
+    msg = launches.add(user_id, "gastei 60 e 70", {})
+    assert msg.startswith("❌ Beleza, deixei de lado: R$ 30,00, R$ 45,00."), msg
+    assert "Em que você gastou R$ 60,00?" in msg, msg
+    # a fila nova ficou inteira
+    fila = db.get_pending_action(user_id)["payload"]["queue"]
+    assert [float(i["valor"]) for i in fila] == [60.0, 70.0], fila
+
+
+def test_controle_primeira_fila_nao_avisa_descarte_nenhum(user_id):
+    # sem este controle, o teste acima passaria num código que grudasse o
