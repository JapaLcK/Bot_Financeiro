+def test_duas_respostas_simultaneas_nao_perdem_o_segundo_valor(user_id):
+    """Dois POSTs do Meta viram duas threads (`wa_app.py:320`) e chegam juntos.
+
+    Sem exclusão mútua as duas leem a fila ANTES de qualquer uma escrever:
+    gravam R$ 30,00 DUAS vezes e os R$ 45,00 somem. Reler a pendência do banco
+    não resolve (as duas leituras acontecem antes da primeira escrita) — quem
+    resolve é o compare-and-swap de `db.advance_pending_action`: a segunda
+    gravação exige que a fila ainda seja a que ela leu, não é, e ela relê.
+
+    Controle negativo medido: com a condição `payload = <o que li>` fora do
+    UPDATE, 0 de 20 rodadas acertam (as 20 gravam [30,00 · 30,00]); com ela,
+    20 de 20 acertam.
+    """
+    _pergunta_destino(user_id)            # fila: R$ 30,00 e R$ 45,00
+    erros: list[BaseException] = []
+
+    def responder(texto: str):
+        try:
+            launches.resolve_multi_launch_value(user_id, texto)
+        except BaseException as e:        # noqa: BLE001 - o teste quer ver
+            erros.append(e)
+
+    ts = [threading.Thread(target=responder, args=(t,)) for t in ("uber", "ifood")]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join(timeout=30)
+
+    assert not erros, erros
+    cats = _cats(user_id)
+    assert sorted(v for _, v in cats) == [30.0, 45.0], cats
+    assert sorted(c for c, _ in cats) == ["alimentação", "transporte"], cats
+    # fila vazia (o pending que sobra é o "categoria errada?" do último add)
+    pend = db.get_pending_action(user_id)
+    assert pend is None or pend["action_type"] != "multi_launch_values", pend
