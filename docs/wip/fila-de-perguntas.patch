+def _drain_live_queue(user_id: int) -> str:
+    """Larga a fila de perguntas que está viva e devolve o aviso — ou "".
+
+    `pending_actions` tem UMA linha por usuário: registrar um lançamento grava
+    a oferta de "categoria errada?" (ou a de gasto fixo) por cima da fila de
+    `multi_launch_values`, e o dinheiro que estava esperando pergunta sumia sem
+    uma palavra. Medido: "gastei 30 e 45" e depois "gastei 20 no mercado"
+    deixava a fila apagada, R$ 30,00 e R$ 45,00 evaporados, e a resposta era só
+    o lançamento de R$ 20,00.
+
+    Fica AQUI, e não em cada chamador, porque `add_from_entities` é por onde
+    todo lançamento passa — texto, áudio, tool da IA e a confirmação de foto de
+    cupom (`core/handlers/pending.py`). Pelo roteador o caso nem chega: a fila
+    é resolvida ou descartada com aviso antes (`core/intent_router.py`); quem
+    entra por fora dele é que atropelava.
+
+    Não fecha os outros 40 sítios que escrevem em `pending_actions` (contados:
+    48 chamadas de `set_pending_action` em 12 arquivos de produção, das quais 8
+    são deste arquivo). Quase todos são alcançados pelo roteador, que já trata a
+    fila primeiro. As duas exceções conhecidas são os slash-commands do Discord
+    (`adapters/discord/cogs/accounts_cog.py:150` e `investments_cog.py:143`):
+    eles não passam pelo roteador, então `/apagar` com uma fila viva ainda a
+    apaga calado. Ficaram de fora de propósito — precisam de um aviso no
+    embed de confirmação, que é outro PR.
+    """
+    p = db.get_pending_action(user_id)
+    if not p or p.get("action_type") != "multi_launch_values":
+        return ""
+    fila = (p.get("payload") or {}).get("queue") or []
+    if not fila:
+        return ""
+    db.clear_pending_action(user_id)
+    return _discard_queue(fila)
+
+
