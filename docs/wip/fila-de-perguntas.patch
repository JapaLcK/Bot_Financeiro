+def enqueue_missing(user_id: int, missing: list[dict], platform: str) -> str:
+    """Grava a fila de perguntas e devolve o aviso do que a fila ANTERIOR levou.
+
+    `pending_actions` tem uma linha por usuário, então gravar a fila nova apaga
+    a antiga. Medido: "gastei 30 e 45" e, em seguida, "gastei 60 e 70" deixava
+    a fila [60, 70] e os R$ 30,00 e R$ 45,00 evaporavam sem uma palavra.
+
+    O aviso é a MESMA frase do descarte (`_discard_queue`) — uma regra só para
+    a classe inteira. Devolve "" quando não havia fila.
+
+    Os dois únicos escritores de `multi_launch_values` chamam aqui: o texto
+    (`add`) e o áudio (`core.handle_incoming._handle_audio`).
+    """
+    velha = db.get_pending_action(user_id)
+    aviso = ""
+    if velha and velha.get("action_type") == "multi_launch_values":
+        fila = (velha.get("payload") or {}).get("queue") or []
+        if fila:
+            aviso = _discard_queue(fila)
+    db.set_pending_action(user_id, "multi_launch_values",
+                          {"queue": missing, "platform": platform})
+    return aviso
+
