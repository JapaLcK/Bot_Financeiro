+def test_rajada_de_lancamento_multiplo_nao_atrasa_quem_so_quer_o_saldo():
+    """Raio de alcance: com o pool todo ocupado por lançamento múltiplo, um
+    usuário sem relação nenhuma com isso ainda consulta. Com o lock antigo a
+    consulta nem começava (BrokenBarrierError)."""
+    from db.connection import _get_pool
+    n = _get_pool().max_size
+    uids = []
+    for _ in range(n):
+        u = int(uuid.uuid4().int % 10_000_000_000)
+        db.ensure_user(u)
+        launches.add(u, "gastei 30 e 45", {})
+        uids.append(u)
+    solto = int(uuid.uuid4().int % 10_000_000_000)
+    db.ensure_user(solto)
+
+    entrou = threading.Barrier(n + 1, timeout=15)
+
+    def rajada(u):
+        entrou.wait()
+        for _ in range(6):
+            launches.resolve_multi_launch_value(u, "uber")
+            launches.add(u, "gastei 30 e 45", {})
+
+    ts = [threading.Thread(target=rajada, args=(u,), daemon=True) for u in uids]
+    for t in ts:
+        t.start()
+    entrou.wait()
+    t0 = time.perf_counter()
+    db.list_launches(solto, limit=5)
+    dt = time.perf_counter() - t0
+    for t in ts:
+        t.join(30)
+    for u in uids:
+        db.clear_pending_action(u)
+    assert dt < 5, f"{dt:.2f}s para uma consulta de terceiro"
+
+
+# ── 13. destino verdadeiro que TEM número não é valor ───────────────────────
+
+# Todos com número no meio do nome. O guarda anterior lia "tem número" como
+# "não é destino" e descartava a fila (6 de 7 medidos).
+DESTINOS_COM_NUMERO = [
+    "posto 24 horas",
+    "farmacia 24h",
+    "padaria 2 irmaos",
+    "cinema 3d",
+    "loja 25 de marco",
+    "mercado 3 coracoes",
+]
+
+
+@pytest.mark.parametrize("destino", DESTINOS_COM_NUMERO)
+def test_destino_com_numero_registra_em_vez_de_descartar(user_id, destino):
+    _pergunta_destino(user_id)                      # fila: R$ 30,00 e R$ 45,00
+    r = launches.resolve_multi_launch_value(user_id, destino)
+    assert r is not None and "deixei de lado" not in r, r
+    assert [v for _, v in _cats(user_id)] == [30.0]
+    # e a fila continua viva pro segundo valor
+    assert launches.resolve_multi_launch_value(user_id, "ifood") is not None
+    assert sorted(v for _, v in _cats(user_id)) == [30.0, 45.0]
+
+
+@pytest.mark.parametrize("destino", DESTINOS_COM_NUMERO)
+def test_controle_o_guarda_antigo_descartaria_os_seis(destino):
+    """Controle negativo: sem o conserto, os seis caem no descarte.
+
+    O critério anterior era literalmente `_extract_valor(resposta) is not
+    None` — e os seis TÊM um número que o `_extract_valor` lê. Sem esta linha,
+    o teste acima passaria igual num guarda que nunca descartou nada.
+    """
+    from parsers import _extract_valor
+    assert _extract_valor(destino) is not None, "o guarda antigo não pegaria"
+    assert not launches._is_value_not_target(destino)
+
+
+@pytest.mark.parametrize("resposta", [
+    "R$ 100",          # valor com símbolo
+    "cem reais",       # valor por extenso (comum no áudio)
+    "gastei 60 e 70",  # mensagem nova de lançamento, não destino
+])
+def test_resposta_que_e_valor_continua_descartando(user_id, resposta):
+    # o outro lado do estreitamento: se ele passar do ponto, isto vira
+    # ('outros', 30, 'cem reais').
+    _pergunta_destino(user_id)
+    r = launches.resolve_multi_launch_value(user_id, resposta)
+    assert r == "❌ Beleza, deixei de lado: R$ 30,00, R$ 45,00.", r
+    assert _cats(user_id) == []
+
+
+def test_conta_e_destino_plausivel_mas_saldo_nao(user_id):
+    """"conta" cai em `balance.check`, a MESMA intent de "saldo" — por isso a
+    exceção é pela palavra, não pela intent. Único termo assim entre as 507
+    varridas."""
+    _pergunta_destino(user_id)
+    r = launches.resolve_multi_launch_value(user_id, "conta")
+    assert r is not None and "deixei de lado" not in r, r
+    assert [v for _, v in _cats(user_id)] == [30.0]
+    # controle: as duas continuam comando (o achado original tem teste no
+    # bloco 4; aqui é a garantia de que a exceção não vazou pra intent)
+    assert launches._is_other_command("saldo")
+    assert launches._is_other_command("qual meu saldo")
