+# ── 11. o separador não trava com uma parede de números ─────────────────────
+
+def test_separador_nao_trava_com_4000_caracteres_de_numeros():
+    """Antes do PR A1 este texto levava 1.609 ms (medido): cada número era um
+    ponto de corte candidato e cada candidato refazia o parse do trecho todo.
+    Uma mensagem de WhatsApp cabe em 4.096 caracteres, então isto é entrada
+    de usuário, não caso teórico."""
+    txt = ("12 " * 1400)[:4000]
+    t0 = time.perf_counter()
+    split(txt)
+    dt_ms = (time.perf_counter() - t0) * 1000
+    assert dt_ms < 5, f"{dt_ms:.1f} ms para 4000 caracteres"
+
