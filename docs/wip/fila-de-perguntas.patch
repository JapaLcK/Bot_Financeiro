+def test_estado_a_nao_resposta_descarta_com_aviso(user_id, resposta):
+    """Medido antes: os cinco abandonavam a fila em silêncio, e dois deles
+    ("gastei 100 no mercado", "gastei 50 no mercado e no posto") ainda gravavam
+    o valor novo na categoria do item da fila — R$ 100,00 em *transporte*."""
