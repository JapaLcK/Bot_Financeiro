+def _discard_queue(queue: list[dict]) -> str:
+    """A frase de "larguei a fila". Quem chama já apagou a pendência.
+
+    Uma frase só para todo mundo: o "cancelar" explícito e as respostas que não
+    servem de destino (comando, número, emoji, branco). Antes, só o "cancelar"
+    avisava — as outras limpavam a fila caladas e o dinheiro sumia junto
+    (medido: responder "fatura" à pergunta dos R$ 300,00 devolvia a lista de
+    cartões e os R$ 300,00 + R$ 45,00 evaporavam sem uma palavra).
+    """
+    return "❌ Beleza, deixei de lado: " + ", ".join(_item_label(i) for i in queue) + "."
+
