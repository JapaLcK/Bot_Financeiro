+    launches.add(user_id, "gastei 30 e 45", {})
+    msg = launches.add(user_id, "gastei 20 no mercado", {})
+    assert msg.startswith("❌ Beleza, deixei de lado: R$ 30,00, R$ 45,00."), msg
+    assert "Despesa registrada" in msg, msg
+    assert [v for _, v in _cats(user_id)] == [20.0]
