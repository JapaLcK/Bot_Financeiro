+# ── 17. o valor recorrente não sobrescreve o número que o usuário digitou ───
+
+def _seed(uid, valor, desc, n=3):
+    for _ in range(n):
+        launches.add_from_entities(uid, tipo="despesa", valor=float(valor),
+                                   alvo=desc, nota=desc)
+
+
+def test_valor_recorrente_nao_sobrescreve_numero_digitado(user_id):
+    """"gastei 30 no uber e no ifood" com histórico de R$25 no uber.
+
+    O pedaço sai da divisão SEM valor de propósito (o 30 pode ser o total ou o
+    de cada um). O recurso de valor recorrente via "item sem valor" e preenchia
+    com o histórico: medido, o bot gravava R$ 25,00 — um número que o usuário
+    não digitou, contradizendo o 30 que ele acabou de escrever.
+    """
+    _seed(user_id, 25, "uber")
+    msg = launches.add(user_id, "gastei 30 no uber e no ifood", {})
+
+    assert "recorrente" not in msg.lower(), msg
+    assert "Quanto foi gasto em *uber*" in msg, msg
+    assert [v for _, v in _cats(user_id, limit=20)] == [25.0, 25.0, 25.0]  # só o histórico
+
