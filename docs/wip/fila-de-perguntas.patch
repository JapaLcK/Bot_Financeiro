+def test_o_aviso_da_fila_nova_e_a_mesma_frase_do_descarte(user_id):
+    """Um caminho só: texto (`launches.add`) e áudio
+    (`core.handle_incoming._handle_audio`) chamam o MESMO `enqueue_missing`, e
+    ele reusa o `_discard_queue` do cancelamento."""
+    assert launches.enqueue_missing(
+        user_id, [{"tipo": "despesa", "valor": 30.0}], "whatsapp") == ""
+    aviso = launches.enqueue_missing(
+        user_id, [{"tipo": "despesa", "valor": 60.0}], "whatsapp")
+    assert aviso == "❌ Beleza, deixei de lado: R$ 30,00."
+    assert aviso == launches._discard_queue([{"tipo": "despesa", "valor": 30.0}])
