+# ── 15. o item não some quando o registro estoura ───────────────────────────
+
+def _estoura_no_teto(monkeypatch):
+    """Simula o teto mensal do Grátis dentro do `add_from_entities`."""
+    import core.services.plan_service as ps
+    from core.services.plan_limits import PlanLimitExceeded
+    def estoura(_uid):
+        raise PlanLimitExceeded("launches_month", "teto do mês")
+    monkeypatch.setattr(ps, "check_can_create_launch", estoura)
+    return PlanLimitExceeded
+
+
+def test_teto_de_plano_no_meio_da_fila_nao_apaga_o_item(user_id, monkeypatch):
+    """Roteiro real: usuário do Grátis manda "gastei 30 e 45", responde "uber"
+    e bate o teto. O compare-and-swap encurta a fila e faz COMMIT antes de
+    chamar o `add_from_entities`; sem devolver a fila, os R$ 30,00 somem e o
+    usuário só vê a mensagem de upgrade.
+
+    Medido sem o conserto: fila antes [30.0, 45.0] → fila depois [45.0],
+    lançamentos [].
+    """
+    _pergunta_destino(user_id)
+    exc = _estoura_no_teto(monkeypatch)
+
+    with pytest.raises(exc):
+        launches.resolve_multi_launch_value(user_id, "uber")
+
+    fila = db.get_pending_action(user_id)
+    assert fila and fila["action_type"] == "multi_launch_values", fila
+    assert [float(i["valor"]) for i in fila["payload"]["queue"]] == [30.0, 45.0]
+    assert _cats(user_id) == []
+
+    # e o teto passando, os dois valores ainda entram — a fila não ficou torta
+    monkeypatch.undo()
+    launches.resolve_multi_launch_value(user_id, "uber")
+    launches.resolve_multi_launch_value(user_id, "ifood")
+    assert sorted(v for _, v in _cats(user_id)) == [30.0, 45.0]
+
+
+def test_teto_no_ULTIMO_item_tambem_devolve_a_fila(user_id, monkeypatch):
+    """O caminho do `novo is None`: quando o item é o último, o CAS APAGA a
+    linha em vez de encurtá-la, então devolver exige recriá-la."""
+    launches.add(user_id, "gastei 30 e 45", {})
+    launches.resolve_multi_launch_value(user_id, "uber")      # sobra [45.0]
+    exc = _estoura_no_teto(monkeypatch)
+
+    with pytest.raises(exc):
+        launches.resolve_multi_launch_value(user_id, "ifood")
+
+    fila = db.get_pending_action(user_id)
+    assert fila and fila["action_type"] == "multi_launch_values", fila
+    assert [float(i["valor"]) for i in fila["payload"]["queue"]] == [45.0]
+
+
+def test_controle_o_cas_continua_impedindo_duplicata(user_id):
+    """Controle negativo do conserto acima: devolver a fila no erro não pode
+    virar 'reivindicar depois de trabalhar'. Duas respostas simultâneas
+    continuam produzindo DOIS lançamentos distintos, não dois iguais."""
+    _pergunta_destino(user_id)
+    erros: list[BaseException] = []
+
+    def responder(texto):
+        try:
+            launches.resolve_multi_launch_value(user_id, texto)
+        except BaseException as e:          # noqa: BLE001 - o teste quer ver
+            erros.append(e)
+
+    ts = [threading.Thread(target=responder, args=(t,)) for t in ("uber", "ifood")]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join(timeout=30)
+    assert not erros, erros
+    assert sorted(v for _, v in _cats(user_id)) == [30.0, 45.0]
