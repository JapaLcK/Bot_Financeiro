+"""
+`handle_quick_entry` também separa múltiplos lançamentos.
+
+Era o irmão esquecido de `core.handlers.launches.add`: chamava
+`parse_receita_despesa_natural` direto, sem o separador. Resultado medido antes
+da correção: "gastei 30 no uber e 45 no ifood" gravava UM lançamento de R$30
+com alvo "uber e 45 no ifood" — R$45 perdidos, e a categoria vindo do destino
+errado.
+
+Não é só o Discord (`adapters/discord/discord_bot.py:209`): a confirmação de
+pendência do WhatsApp (`core/handlers/pending.py:68`) passa pelo mesmo caminho.
+"""
+from __future__ import annotations
+
+import db
+from core.services.quick_entry import handle_quick_entry
+
+
+def _cats(user_id):
+    rows = sorted(db.list_launches(user_id, limit=10), key=lambda r: r["id"])
+    return [(r["categoria"], float(r["valor"])) for r in rows]
+
+
+def test_dois_lancamentos_na_mesma_mensagem(user_id):
+    msg = handle_quick_entry(user_id, "gastei 30 no uber e 45 no ifood")
+    assert msg is not None
+    assert _cats(user_id) == [("transporte", 30.0), ("alimentação", 45.0)]
+    assert msg.text.count("registrada") == 2
+
+
+def test_separador_ausente_fica_um_lancamento_so(user_id):
+    # PR A1: sem separador explícito não se divide (o PR A2 decide estas com
+    # IA). Mesmo comportamento da `main` e do `launches.add`.
+    handle_quick_entry(user_id, "35 padaria 80 farmacia")
+    assert _cats(user_id) == [("alimentação", 35.0)]
+
+
+def test_controle_com_separador_continua_dois(user_id):
+    handle_quick_entry(user_id, "35 padaria e 80 farmacia")
+    assert _cats(user_id) == [("alimentação", 35.0), ("saúde", 80.0)]
+
+
+def test_nao_dobra_gasto_de_uma_coisa_so(user_id):
+    handle_quick_entry(user_id, "gastei 80 no banho e tosa")
+    assert [v for _, v in _cats(user_id)] == [80.0]
+
+
+def test_lancamento_unico_continua_igual(user_id):
+    msg = handle_quick_entry(user_id, "gastei 50 no mercado")
+    assert msg is not None and _cats(user_id) == [("mercado", 50.0)]
+
+
+def test_texto_que_nao_e_lancamento_continua_none(user_id):
+    assert handle_quick_entry(user_id, "bom dia") is None
