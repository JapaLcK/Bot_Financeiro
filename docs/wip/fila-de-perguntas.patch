+def test_controle_valor_recorrente_continua_valendo_sem_valor_digitado(user_id):
+    """O controle negativo: em "... e paguei o aluguel" o usuário NÃO deu valor
+    pro aluguel — o histórico pode preencher, e tem que continuar preenchendo.
+    Sem este teste, o de cima passaria num código que só desligou o recurso."""
+    _seed(user_id, 1500, "aluguel", n=2)
+    msg = launches.add(user_id, "gastei 500 no ifood e paguei o aluguel", {})
+
+    assert "recorrente" in msg.lower(), msg
+    assert sorted(v for _, v in _cats(user_id, limit=20)) == [500.0, 1500.0, 1500.0, 1500.0]
