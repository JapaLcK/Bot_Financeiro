+
+# ── 16. lançamento normal em cima de fila viva não a engole calada ──────────
+
+def test_lancamento_normal_depois_de_fila_viva_avisa(user_id):
+    """A irmã do bloco 14, e a mais comum: QUALQUER lançamento seguinte grava
