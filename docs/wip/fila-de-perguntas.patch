+# ── 12. o mecanismo de concorrência não pode derrubar o resto do bot ────────
+#
+# O primeiro conserto da corrida do bloco 9 foi um `pg_advisory_xact_lock` que
+# segurava uma conexão INTEIRA do pool enquanto o trabalho de dentro pedia
+# outra. Com `DB_POOL_MAX_SYNC=8` isso media: 8 usuários simultâneos = 0
+# sucessos e 8 erros, e um NONO usuário não conseguia nem listar lançamentos.
+# Os três testes abaixo são o que sobrou daquelas sondas.
+
+def test_cas_recusa_gravar_por_cima_de_fila_ja_avancada(user_id):
+    """O compare-and-swap em si: só grava se a fila ainda for a que foi lida."""
+    fila_a = {"queue": [{"tipo": "despesa", "valor": 30.0}], "platform": "whatsapp"}
+    fila_b = {"queue": [{"tipo": "despesa", "valor": 45.0}], "platform": "whatsapp"}
+    db.set_pending_action(user_id, "multi_launch_values", fila_a)
+
+    # quem leu `fila_a` e ainda vale: grava
+    assert db.advance_pending_action(user_id, "multi_launch_values", fila_a, fila_b)
+    # quem leu `fila_a` DEPOIS de alguém já ter avançado: não grava
+    assert not db.advance_pending_action(user_id, "multi_launch_values", fila_a, None)
+    # a fila continua sendo a de quem venceu, intacta
+    assert db.get_pending_action(user_id)["payload"] == fila_b
+    # e o apagar também é condicional
+    assert db.advance_pending_action(user_id, "multi_launch_values", fila_b, None)
+    assert db.get_pending_action(user_id) is None
+
