+def _is_other_command(text: str) -> bool:
+    """A resposta é um comando conhecido do bot, e não um destino de gasto?
+
+    Só os dois níveis DETERMINÍSTICOS do classificador (tabela exata + regex de
+    alias): precisa valer sem `OPENAI_API_KEY` e sem chamada de rede. Medido
+    contra as 483 palavras de `CATEGORY_KEYWORDS`: uma única ("comprei online")
+    casa alguma regra, e casa `launches.add` — que o teste de valor logo acima
+    já resolve. Por isso `launches.add` fica de fora daqui.
+
+    E fora também as intents cujo nome é, antes de tudo, um lugar onde dinheiro
+    vai: quem responde "fatura", "extrato", "cartão", "investimento" ou
+    "caixinha" à pergunta "em que você gastou R$ 300,00?" está nomeando o
+    DESTINO, não pedindo o relatório. "saldo", "ajuda", "relatório" e "resumo"
+    continuam comandos — ninguém gasta dinheiro "no saldo".
+
+    "conta" é o mesmo caso, mas não sai pela intent: ela cai em `balance.check`
+    junto com "saldo". Vai pela palavra (`_DEST_LIKE_WORDS`) — "paguei a conta"
+    é destino; "qual meu saldo" não.
+    """
+    from core.intent_classifier import _try_exact, _try_alias, _normalize
+    norm = _normalize(text)
+    if norm in _DEST_LIKE_WORDS:
+        return False
+    res = _try_exact(norm) or _try_alias(norm, text)
+    return (res is not None
+            and res.intent != "launches.add"
+            and res.intent not in _DEST_LIKE_INTENTS)
+
